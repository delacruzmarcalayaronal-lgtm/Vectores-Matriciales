# MatrixFlow Enterprise - Backend
# Copia este archivo como .env y ajusta los valores.

# Base de datos (SQLite local o PostgreSQL/Supabase en producción)
DATABASE_URL=sqlite:///./matrixflow.db
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/matrixflow

# Seguridad JWT
SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase (opcional, fase de producción)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
